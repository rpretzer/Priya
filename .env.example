# Hoopla Coach — environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   docker compose up
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# Port to listen on (default: 3456)
PORT=3456

# Number of uvicorn worker processes (default: 1; use 2-4 for beta)
WORKERS=2

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# ── Session security ──────────────────────────────────────────────────────────

# Secret used to HMAC-sign session tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED for production. If unset, a random ephemeral secret is used per
# process (sessions invalidated on restart).
SESSION_SECRET=replace_me_with_a_long_random_string

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins. Default "*" is open (dev only).
# Production: set to your actual frontend origin, e.g. https://coach.hoopla.digital
CORS_ORIGINS=*

# ── Backend selection ─────────────────────────────────────────────────────────

# Which LLM backend to use: ollama | llamacpp | bedrock | assisted | agentcore
BACKEND=ollama

# ── Ollama backend ────────────────────────────────────────────────────────────

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── llama.cpp backend ─────────────────────────────────────────────────────────

# LLAMACPP_BASE_URL=http://localhost:8080
# LLAMACPP_MODEL=local

# ── AWS Bedrock backend ───────────────────────────────────────────────────────

# AWS_REGION=us-east-1
# AWS_PROFILE=                           # optional: named AWS profile for local dev
# BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0

# ── Anthropic API (assisted) backend ─────────────────────────────────────────

# ANTHROPIC_API_KEY=sk-ant-...           # REQUIRED for assisted backend
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Slack bot ─────────────────────────────────────────────────────────────────

# SLACK_BOT_TOKEN=xoxb-...              # Bot user OAuth token
# SLACK_APP_TOKEN=xapp-...              # App-level token (Socket Mode)
# COACH_SERVER_URL=http://localhost:3456

# ── Memory ────────────────────────────────────────────────────────────────────

# Path to SQLite memory database. In Docker, use /data/memory.db (mounted volume).
# Default: ~/.hoopla/memory.db
# MEMORY_PATH=/data/memory.db
